    {
        skip_install_trust

        auto_https off

        {$FP_GLOBAL_OPTIONS}

        frankenphp {
          php_ini {
                  disable_functions exec,passthru,shell_exec,system,proc_open,popen,show_source
                  memory_limit 1G
                  max_execution_time {$FP_MAX_EXECUTION_TIME:600}
                  max_input_time {$FP_MAX_INPUT_TIME:600}
          }

          # Fail with 503 instead of queueing forever when every PHP thread is busy.
          max_wait_time {$FP_MAX_WAIT_TIME:30s}

          {$FP_FRANKENPHP_OPTIONS}
        }

        http_port {$FP_HTTP_PORT:8080}

        order respond before reverse_proxy
        order rewrite before respond
        order route before rewrite
        servers {
          trusted_proxies static {$FP_TRUSTED_PROXIES:private_ranges}
        }
    }

    {$FP_EXTRA_CONFIG}

    {$FP_SERVER_NAME}, http:// {
          encode zstd br gzip
          log {
            level {$FP_LOG_LEVEL:WARN}
          }

          {$FP_SERVER_OPTIONS}

          # Content-Security-Policy. Defaults are deliberately WordPress-compatible
          # (wp-admin and most plugins need inline/eval scripts and inline styles) while
          # still blocking plugins/objects, base tag hijacking, framing by other sites
          # and non-https external resources. Override the whole policy with FP_CSP,
          # test a stricter one with FP_CSP_HEADER=Content-Security-Policy-Report-Only,
          # or turn it off with FP_CSP_ENABLED=false.
          @csp expression `"{$FP_CSP_ENABLED:true}" == "true"`
          header @csp {
            {$FP_CSP_HEADER:Content-Security-Policy} "{$FP_CSP:default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' data: blob: https:; frame-src 'self' https: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'self'}"
          }

          # Companion security headers (FP_SECURITY_HEADERS=false to disable).
          @security_headers expression `"{$FP_SECURITY_HEADERS:true}" == "true"`
          header @security_headers {
            X-Content-Type-Options nosniff
            X-Frame-Options SAMEORIGIN
            Referrer-Policy strict-origin-when-cross-origin
            -X-Powered-By
          }

          # Browser caching of static files, as a default: a response that sets its own
          # Cache-Control keeps it, and only files that exist get one. A URL with ?ver= changes when
          # the file does, so it may be kept for a year; other static files a week.
          # Override with FP_CACHE_VERSIONED / FP_CACHE_STATIC (e.g. no-cache).
          @static_versioned {
            path_regexp static_versioned (?i)\.(css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mp3|pdf)$
            query ver=*
            file {
              root /app/web
            }
          }
          header @static_versioned ?Cache-Control "{$FP_CACHE_VERSIONED:public, max-age=31536000, immutable}"
          @static_plain {
            path_regexp static_plain (?i)\.(css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mp3|pdf)$
            not query ver=*
            file {
              root /app/web
            }
          }
          header @static_plain ?Cache-Control "{$FP_CACHE_STATIC:public, max-age=604800}"

          # Keep denials ahead of rewrites, WebP negotiation and PHP dispatch.
          route {
            @xmlrpc_disabled {
              path_regexp xmlrpc (?i)(^|/)xmlrpc\.php
              expression `"{$FP_XMLRPC_ENABLED:false}" != "true"`
            }
            respond @xmlrpc_disabled "Forbidden" 403

            @private_files {
              path_regexp private_files (?i)(^|/)(wp-config\.php[^/]*|(composer\.(json|lock)|auth\.json|debug\.log)([.~][^/]*)?)(/|$)
            }
            respond @private_files "Forbidden" 403

            @protected_php {
              path_regexp protected_php (?i)/(?:app/(?:uploads|cache)|wp-content/(?:uploads|cache)|uploads|cache|(?:wp/)?wp-includes)(?:/.*)?/[^/]*\.(?:php[^/]*|phtml|pht|phar)(?:/|$)
            }
            respond @protected_php "Forbidden" 403

            @dotfiles {
              path_regexp dotfiles (^|/)\.
              not path /.well-known/*
            }
            respond @dotfiles "Forbidden" 403
            # The public .well-known namespace must not expose nested dotfiles.
            @well_known_dotfiles path_regexp well_known_dotfiles ^/\.well-known/(.*/)?\.
            respond @well_known_dotfiles "Forbidden" 403

            @healthcheck {
              path /unit-ping /fpm-ping
            }
            respond @healthcheck "OK" 200

            @wpadmin {
              path_regexp wpadmin ^/wp-admin(.*)$
            }
            redir @wpadmin /wp/wp-admin{re.wpadmin.1} permanent

            @wplogin {
              path /wp-login.php*
            }
            redir @wplogin /wp/wp-login.php permanent

            # Serve a pre-generated .webp (photo.jpg.webp or photo.webp) in place of the original,
            # only to clients that accept it. FP_WEBP_ENABLED=false turns it off, for sites behind
            # a CDN that caches one answer per URL whatever the client accepts (Cloudflare).
            @webp_images {
              path_regexp webp_images (?i)^(.+)\.(jpe?g|png|gif)$
              expression `"{$FP_WEBP_ENABLED:true}" == "true"`
            }
            header @webp_images +Vary Accept
            @webp {
              path_regexp webp (?i)^(.+)\.(jpe?g|png|gif)$
              header Accept *image/webp*
              expression `"{$FP_WEBP_ENABLED:true}" == "true"`
              file {
                root /app/web
                try_files {path}.webp {dir}{file.base}.webp
              }
            }
            rewrite @webp {file_match.relative}

            # These trees are static-only, including requests for directory indexes.
            @static_only path_regexp static_only (?i)/(?:app/(?:uploads|cache)|wp-content/(?:uploads|cache)|uploads|cache|(?:wp/)?wp-includes)(/|$)
            handle @static_only {
              root * /app/web
              file_server
            }

            root /app/web

            # TLS terminated by a trusted proxy (ingress, load balancer): FrankenPHP only
            # sets HTTPS from the actual connection, so tell PHP/WordPress about it.
            @fwd_https {
              header X-Forwarded-Proto https
              remote_ip {$FP_TRUSTED_PROXIES:private_ranges}
            }
            php_server @fwd_https {
                root /app/web
                env HTTPS on
                env REQUEST_SCHEME https

                {$FP_PHP_SERVER_OPTIONS}
            }

            php_server {
                root /app/web

                {$FP_PHP_SERVER_OPTIONS}
            }
          }
    }

    # As an alternative to editing the above site block, you can add your own site
    # block files in the Caddyfile.d directory, and they will be included as long
    # as they use the .caddyfile extension.

    import Caddyfile.d/*.caddyfile
