    {
        skip_install_trust

        auto_https off

        {$FP_GLOBAL_OPTIONS}

        frankenphp {
          php_ini {
                  disable_functions exec,passthru,shell_exec,system,proc_open,popen,show_source
                  memory_limit 1G
                  max_execution_time {$FP_MAX_EXECUTION_TIME:600}
                  max_input_time {$FP_MAX_INPUT_TIME:600}
          }

          # Fail with 503 instead of queueing forever when every PHP thread is busy.
          max_wait_time {$FP_MAX_WAIT_TIME:30s}

          {$FP_FRANKENPHP_OPTIONS}
        }

        http_port {$FP_HTTP_PORT:8080}

        order respond before reverse_proxy
        order rewrite before respond
        order route before rewrite
        servers {
          trusted_proxies static {$FP_TRUSTED_PROXIES:private_ranges}
        }
    }

    {$FP_EXTRA_CONFIG}

    {$FP_SERVER_NAME}, http:// {
          encode zstd br gzip
          log {
            level {$FP_LOG_LEVEL:WARN}
          }

          {$FP_SERVER_OPTIONS}

          # Content-Security-Policy. Defaults are deliberately WordPress-compatible
          # (wp-admin and most plugins need inline/eval scripts and inline styles) while
          # still blocking plugins/objects, base tag hijacking, framing by other sites
          # and non-https external resources. Override the whole policy with FP_CSP,
          # test a stricter one with FP_CSP_HEADER=Content-Security-Policy-Report-Only,
          # or turn it off with FP_CSP_ENABLED=false.
          @csp expression `"{$FP_CSP_ENABLED:true}" == "true"`
          header @csp {
            {$FP_CSP_HEADER:Content-Security-Policy} "{$FP_CSP:default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' data: blob: https:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'self'}"
          }

          # Companion security headers (FP_SECURITY_HEADERS=false to disable).
          @security_headers expression `"{$FP_SECURITY_HEADERS:true}" == "true"`
          header @security_headers {
            X-Content-Type-Options nosniff
            X-Frame-Options SAMEORIGIN
            Referrer-Policy strict-origin-when-cross-origin
            -X-Powered-By
          }

          @healthcheck {
            path /unit-ping /fpm-ping
          }
          respond @healthcheck "OK" 200

          @wpadmin {
            path_regexp wpadmin ^/wp-admin(.*)$
          }
          redir @wpadmin /wp/wp-admin{re.wpadmin.1} permanent

          @wplogin {
            path /wp-login.php*
          }
          redir @wplogin /wp/wp-login.php permanent

          @uploadsphp {
            path /app/uploads/*.php
          }
          respond @uploadsphp "Unauthorized" 401

          # Serve a pre-generated .webp next to the original, only to clients that accept it.
          @images {
            path_regexp images ^(.+)\.(jpg|jpeg|png|gif)$
            header Accept *image/webp*
          }
          handle @images {
            root * /app/web
            header +Vary Accept
            try_files {path}.webp {re.images.1}.webp {path}
            file_server
          }

          root /app/web

          # TLS terminated by a trusted proxy (ingress, load balancer): FrankenPHP only
          # sets HTTPS from the actual connection, so tell PHP/WordPress about it.
          @fwd_https {
            header X-Forwarded-Proto https
            remote_ip {$FP_TRUSTED_PROXIES:private_ranges}
          }
          php_server @fwd_https {
              root /app/web
              env HTTPS on
              env REQUEST_SCHEME https

              {$FP_PHP_SERVER_OPTIONS}
          }

          php_server {
              root /app/web

              {$FP_PHP_SERVER_OPTIONS}
          }
    }

    # As an alternative to editing the above site block, you can add your own site
    # block files in the Caddyfile.d directory, and they will be included as long
    # as they use the .caddyfile extension.

    import Caddyfile.d/*.caddyfile
